@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The bundled FindGMP.cmake is installed next to this file so that
# find_dependency(GMP) resolves for downstream consumers.
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(GMP 6.0)
find_dependency(Threads)
list(REMOVE_AT CMAKE_MODULE_PATH 0)

include("${CMAKE_CURRENT_LIST_DIR}/TifaTargets.cmake")

# Consumable targets:
#   Tifa::tifa         -> shared library (libtifa.so / libtifa.dylib)
#   Tifa::tifa_static  -> static library (libtifa.a)

check_required_components(Tifa)
