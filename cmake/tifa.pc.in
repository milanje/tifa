prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: TIFA
Description: Tools for Integer FActorization
Version: @PROJECT_VERSION@
Requires.private: @TIFA_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -ltifa
Libs.private: @TIFA_PC_LIBS_PRIVATE@
Cflags: -I${includedir}/tifa@TIFA_PC_CFLAGS_EXTRA@
