#if !defined(_TIFA_CONFIG_H_)
#define _TIFA_CONFIG_H_

// Standard limits are used to derive the machine-dependent constants below
// (ULONG_MAX, LONG_MAX, CHAR_BIT, ...) instead of probing them at configure
// time. This keeps configuration free of run-tests and cross-compile safe.
#include <limits.h>

/* Marks the public API: the shared library exports nothing else. */
#if defined(__GNUC__)
#define TIFA_API __attribute__((visibility("default")))
#else
#define TIFA_API
#endif

/* Name of package */
#define TIFA_SHORTNAME "@TIFA_CFG_SHORTNAME@"

/* Define to the address where bug reports for this package should be sent. */
#define TIFA_BUGREPORT "@TIFA_CFG_BUGREPORT@"

/* Define to the full name of this package. */
#define TIFA_FULLNAME "@TIFA_CFG_FULLNAME@"

/* Define to the name and version of this package. */
#define TIFA_STRING "@TIFA_CFG_STRING@"

/* Define to the one symbol short name of this package. */
#define TIFA_TARNAME "@TIFA_CFG_TARNAME@"

/* Version number of package */
#define TIFA_VERSION "@TIFA_CFG_VERSION@"

/* Major version number of package */
#define TIFA_VERSION_MAJOR @TIFA_CFG_VERSION_MAJOR@

/* Minor version number of package */
#define TIFA_VERSION_MINOR @TIFA_CFG_VERSION_MINOR@

/* Patch version number of package */
#define TIFA_VERSION_PATCH @TIFA_CFG_VERSION_PATCH@

/* Size of machine word in bits */
#define TIFA_WORDSIZE (TIFA_SIZEOF_ULONG_T * CHAR_BIT)

/* Identification of machine used to compile TIFA */
#define TIFA_COMPILED_ON "@TIFA_CFG_COMPILED_ON@"

/* Identification of machine used to compile TIFA (OS only) */
#define TIFA_COMPILED_ON_OS "@TIFA_CFG_COMPILED_ON_OS@"

/* Identification of machine used to compile TIFA (OS release only) */
#define TIFA_COMPILED_ON_RELEASE "@TIFA_CFG_COMPILED_ON_RELEASE@"

/* Identification of machine used to compile TIFA (architecture only) */
#define TIFA_COMPILED_ON_MACHINE "@TIFA_CFG_COMPILED_ON_MACHINE@"

/* Set to 1 to use calloc/memset for integer array initialization */
#define TIFA_USE_CALLOC_MEMSET @TIFA_CFG_USE_CALLOC_MEMSET@

/* Set to 1 to allow use of some GMP's internal functions */
#define TIFA_USE_GMP_INTERNAL_FUNCS @TIFA_CFG_USE_GMP_INTERNAL_FUNCS@

/* Native type used to represent a string of bits */
#define TIFA_BITSTRING_T @TIFA_CFG_BITSTRING_T@

/* Directory searched at runtime for machine-tuned parameter files. Empty means
 * no compiled-in default location (only tifa_tuning_set_dir() / the
 * TIFA_TUNING_DIR environment variable are consulted). */
#define TIFA_TUNING_DIR "@TIFA_CFG_TUNING_DIR@"

/* Set to 1 to compile in the baked parameter-tuning tables (tuning_baked.c) as
 * a fallback consulted when no runtime tuning file is found. */
#define TIFA_USE_BAKED_TUNING @TIFA_CFG_USE_BAKED_TUNING@

/* Size of type (in sizeof units) used to represent a string of bits */
#define TIFA_SIZEOF_BITSTRING_T @TIFA_CFG_SIZEOF_BITSTRING_T@

/* Size of type (in bits) used to represent a string of bits */
#define TIFA_BITSTRING_T_BITSIZE (TIFA_SIZEOF_BITSTRING_T * CHAR_BIT)

/* Size of type "unsigned long int" (in sizeof units) */
#define TIFA_SIZEOF_ULONG_T @TIFA_CFG_SIZEOF_ULONG_T@

/* Size of type "unsigned long int" (in bits) */
#define TIFA_ULONG_T_BITSIZE (TIFA_SIZEOF_ULONG_T * CHAR_BIT)

/* Max value for unsigned long integers and some useful fractions */
#define TIFA_ULONG_MAX ULONG_MAX
#define TIFA_ULONG_MAX_DIVIDED_BY_2 (ULONG_MAX / 2)
#define TIFA_ULONG_MAX_DIVIDED_BY_3 (ULONG_MAX / 3)
#define TIFA_ULONG_MAX_DIVIDED_BY_4 (ULONG_MAX / 4)
#define TIFA_ULONG_MAX_DIVIDED_BY_5 (ULONG_MAX / 5)
#define TIFA_ULONG_MAX_DIVIDED_BY_6 (ULONG_MAX / 6)
#define TIFA_SQRT_ULONG_MAX @TIFA_CFG_SQRT_ULONG_MAX@

/* Max value for signed long integers and some useful fractions */
#define TIFA_LONG_MAX LONG_MAX
#define TIFA_LONG_MAX_DIVIDED_BY_2 (LONG_MAX / 2)
#define TIFA_LONG_MAX_DIVIDED_BY_3 (LONG_MAX / 3)
#define TIFA_LONG_MAX_DIVIDED_BY_4 (LONG_MAX / 4)
#define TIFA_LONG_MAX_DIVIDED_BY_5 (LONG_MAX / 5)
#define TIFA_LONG_MAX_DIVIDED_BY_6 (LONG_MAX / 6)
#define TIFA_SQRT_LONG_MAX @TIFA_CFG_SQRT_LONG_MAX@

/* Logarithm in base 10 of largest value of a GMP limb.
 * Derived from gmp.h's own GMP_NUMB_MAX at the (single, non-hot) use site,
 * which already includes <gmp.h> and <math.h>. */
#define LOG10_GMP_NUMB_MAX (log10((double)GMP_NUMB_MAX))

/* Define to 1 to print critical error messages on stderr */
#define TIFA_PRINT_ERROR @TIFA_CFG_PRINT_ERROR@

/* Define to 1 to turn on output messages for the cfrac function */
#define TIFA_VERBOSE_CFRAC @TIFA_CFG_VERBOSE_CFRAC@

/* Define to 1 to turn on output messages for the ecm function */
#define TIFA_VERBOSE_ECM @TIFA_CFG_VERBOSE_ECM@

/* Define to 1 to turn on output messages for the fermat function */
#define TIFA_VERBOSE_FERMAT @TIFA_CFG_VERBOSE_FERMAT@

/* Define to 1 to turn on output messages for the siqs function */
#define TIFA_VERBOSE_SIQS @TIFA_CFG_VERBOSE_SIQS@

/* Define to 1 to turn on output messages for the squfof function */
#define TIFA_VERBOSE_SQUFOF @TIFA_CFG_VERBOSE_SQUFOF@

/* Define to 1 to turn on output messages for the tdiv function */
#define TIFA_VERBOSE_TDIV @TIFA_CFG_VERBOSE_TDIV@

/* Define to 1 to turn on output messages for the rho function */
#define TIFA_VERBOSE_RHO @TIFA_CFG_VERBOSE_RHO@

/* Define to 1 to turn on output messages for the p-1 function */
#define TIFA_VERBOSE_PM1 @TIFA_CFG_VERBOSE_PM1@

/* Define to 1 to turn on output messages for the p+1 function */
#define TIFA_VERBOSE_PP1 @TIFA_CFG_VERBOSE_PP1@

/* Define to 1 to turn on extra (potentially costly) timing messages */
#define TIFA_EXTRA_TIMING @TIFA_CFG_ALLOW_EXTRA_TIMING@

/* Define to 1 to turn on timing messages for the cfrac function */
#define TIFA_TIMING_CFRAC @TIFA_CFG_TIMING_CFRAC@

/* Define to 1 to turn on timing messages for the ecm function */
#define TIFA_TIMING_ECM @TIFA_CFG_TIMING_ECM@

/* Define to 1 to turn on timing messages for the fermat function */
#define TIFA_TIMING_FERMAT @TIFA_CFG_TIMING_FERMAT@

/* Define to 1 to turn on timing messages for the siqs function */
#define TIFA_TIMING_SIQS @TIFA_CFG_TIMING_SIQS@

/* Define to 1 to turn on timing messages for the squfof function */
#define TIFA_TIMING_SQUFOF @TIFA_CFG_TIMING_SQUFOF@

/* Define to 1 to turn on timing messages for the tdiv function */
#define TIFA_TIMING_TDIV @TIFA_CFG_TIMING_TDIV@

/* Define to 1 to turn on timing messages for the rho function */
#define TIFA_TIMING_RHO @TIFA_CFG_TIMING_RHO@

/* Define to 1 to turn on timing messages for the p-1 function */
#define TIFA_TIMING_PM1 @TIFA_CFG_TIMING_PM1@

/* Define to 1 to turn on timing messages for the p+1 function */
#define TIFA_TIMING_PP1 @TIFA_CFG_TIMING_PP1@

/* NOTE: TIFA_ENDIANNESS was dropped during the CMake migration: it was never
 * referenced anywhere in the TIFA sources. Use CMAKE_C_BYTE_ORDER at configure
 * time if a value is ever needed again. */

/* Other symbols not configuration related but that don't fit elsewhere */
